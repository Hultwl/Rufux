# Maintainer: Hultwl <Hultwl@users.noreply.github.com>
pkgname=rufux
pkgver=2.1
pkgrel=1
pkgdesc="Rufux — bootable USB creator for Linux (Rufus port)"
arch=('x86_64' 'aarch64')
url="https://github.com/Hultwl/Rufux"
license=('GPL-3.0-or-later')
depends=('gtk4' 'hicolor-icon-theme' 'openssl' 'udisks2' 'util-linux')
makedepends=('cmake' 'gcc' 'pkgconf' 'gettext')
optdepends=(
  'dosfstools: FAT32 formatting (mkfs.vfat)'
  'ntfsprogs: NTFS formatting (mkfs.ntfs)'
  'exfatprogs: exFAT formatting (mkfs.exfat)'
  'e2fsprogs: ext4 formatting and persistence'
  'libarchive: ISO extraction (bsdtar)'
  'p7zip: required for UDF/Windows ISOs, fallback otherwise (7z)'
  'wimlib: Windows 11 checks bypass inside boot.wim (wimlib-imagex)'
  'hivex: offline registry editing for the bypass (hivexsh)'
  'syslinux: BIOS/GPT MBR + syslinux install'
  'grub: legacy BIOS boot for Windows media (grub-mkimage, grub-bios-setup)'
  'smartmontools: drive health check before writing (smartctl)'
  'qemu-img: VHDX, VMDK, QCOW2, VDI and dynamic VHD images (qemu-img)'
  'xorriso: ISO building for tests'
  'curl: Windows ISO download and release update checks'
  'polkit: privilege escalation via pkexec'
)
source=("git+https://github.com/Hultwl/Rufux.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$pkgname" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
