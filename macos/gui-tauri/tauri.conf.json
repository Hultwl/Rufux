{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rufux",
  "version": "2.3.0",
  "identifier": "io.github.hultwl.rufux",
  "build": {
    "frontendDist": "./ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rufux 2.3.0",
        "width": 472,
        "height": 620,
        "minWidth": 472,
        "resizable": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/Rufux.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
